{
  "name": "mpx-docs",
  "private": true,
  "description": "mpx 文档站、React 管理界面与浏览器测试",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "ui:build": "tsc --noEmit -p internal/ui/frontend/tsconfig.json && vite build --config internal/ui/frontend/vite.config.ts && node scripts/package-ui.mjs",
    "ui:typecheck": "tsc --noEmit -p internal/ui/frontend/tsconfig.json",
    "test:ui": "playwright test -c internal/ui/e2e",
    "ui:check": "node scripts/check-ui-system.mjs && node scripts/sync-ui-icons.mjs --check",
    "ui:icons:check": "node scripts/sync-ui-icons.mjs --check",
    "ui:components": "npm run ui:build && python3 -m http.server 5179 --bind 127.0.0.1 --directory internal/ui/assets",
    "docs:shots": "node scripts/docs-shots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
