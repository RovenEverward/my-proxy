    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "本地直连"
      },
      {
        "rule_set": [
          "private"
        ],
        "outbound": "本地直连"
      },
      {
        "rule_set": [
          "ai"
        ],
        "outbound": "AI 服务"
      },
      {
        "rule_set": [
          "youtube",
          "netflix",
          "disney",
          "hbo",
          "primevideo",
          "spotify",
          "twitch",
          "tiktok"
        ],
        "outbound": "流媒体"
      },
      {
        "rule_set": [
          "telegram",
          "telegram-ip"
        ],
        "outbound": "Telegram"
      },
      {
        "rule_set": [
          "microsoft"
        ],
        "outbound": "微软"
      },
      {
        "rule_set": [
          "apple"
        ],
        "outbound": "苹果"
      },
      {
        "rule_set": [
          "cn",
          "cn-games",
          "cn-ip"
        ],
        "outbound": "本地直连"
      }
    ],
    "final": "漏网之鱼",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
