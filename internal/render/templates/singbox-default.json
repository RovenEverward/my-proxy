{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-remote",
        "server": "1.1.1.2",
        "detour": "proxy"
      },
      {
        "type": "local",
        "tag": "dns-direct"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "cdn.jsdelivr.net"
        ],
        "server": "dns-direct"
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": null
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": null,
      "url": "http://www.gstatic.com/generate_204",
      "interval": "5m"
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "selector",
      "tag": "全球代理",
      "outbounds": [
        "proxy",
        "auto",
        "direct"
      ],
      "default": "proxy"
    },
    {
      "type": "selector",
      "tag": "本地直连",
      "outbounds": [
        "direct",
        "全球代理"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "AI 服务",
      "outbounds": [
        "全球代理",
        "proxy",
        "direct"
      ],
      "default": "全球代理"
    },
    {
      "type": "selector",
      "tag": "流媒体",
      "outbounds": [
        "全球代理",
        "proxy",
        "direct"
      ],
      "default": "全球代理"
    },
    {
      "type": "selector",
      "tag": "Telegram",
      "outbounds": [
        "全球代理",
        "proxy",
        "direct"
      ],
      "default": "全球代理"
    },
    {
      "type": "selector",
      "tag": "微软",
      "outbounds": [
        "全球代理",
        "proxy",
        "direct"
      ],
      "default": "全球代理"
    },
    {
      "type": "selector",
      "tag": "苹果",
      "outbounds": [
        "direct",
        "全球代理",
        "proxy"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "漏网之鱼",
      "outbounds": [
        "全球代理",
        "proxy",
        "direct"
      ],
      "default": "全球代理"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "tag": "private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "ai",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "youtube",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.srs",
