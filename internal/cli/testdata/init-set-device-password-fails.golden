stdout:
fake install line
fake install line

stderr:
==> 看清这台机器
    Linux x86_64,root,fetch=/usr/bin/curl
==> 把安装脚本送上去
    用的是本机的 <TMPDIR>/install.sh
==> 在 VPS 上装控制面(监听 0.0.0.0:8080)
==> 建节点、入站、入口、订阅设置与用户
==> 设置设备密码
err: 设置设备密码失败(装上的 mpx 可能比这个功能旧,可用 --binary 指本机编好的 linux mpx):boom fake set password failed
calls:
printf 'os=%s\n' "$(uname -s)"
printf 'arch=%s\n' "$(uname -m)"
printf 'uid=%s\n' "$(id -u)"
printf 'fetch=%s\n' "$(command -v curl || command -v wget || echo)"
printf 'mpx=%s\n' "$(command -v mpx || echo)"
---
PutFile /tmp/mpx-install.sh
---
bash '/tmp/mpx-install.sh' --addr '0.0.0.0:8080'
---
mpx bootstrap --help >/dev/null 2>&1 && echo MPX_BOOTSTRAP_OK || echo MPX_BOOTSTRAP_MISSING
---
'mpx' 'bootstrap' '--address' '203.0.113.10' '--ssh-user' 'root' '--ssh-port' '22' '--api-port' '8080' '--name' 'default' '--username' 'user1' '--sni' 'www.cloudflare.com' '--reality-dest' 'www.cloudflare.com:443'
---
cat /var/lib/mpx/tls-fingerprint
---
MPX_TOKEN="$(sed -n 's/^MPX_TOKEN=//p' /etc/mpx/env)" mpx --server http://127.0.0.1:8080 device password --password-stdin
---
